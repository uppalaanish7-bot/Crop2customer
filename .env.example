# Crop2Costumer — Environment Configuration Example
# Copy this file to .env or export these variables in your terminal before running `python app.py`.

# 1. Core Application & Session Security
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=replace-with-a-strong-random-secret-key
APP_ENV=development
PORT=5000
HOST=127.0.0.1
COOKIE_SECURE=false

# Optional durable storage locations (defaults: ./data/marketplace.db and ./uploads)
# DATABASE_PATH=
# UPLOAD_DIR=

# 2. Development OTP Fallback (1234)
# In development mode (APP_ENV=development and ENABLE_DEV_OTP=true), common OTP 1234 is accepted
# when no SMS provider is configured, with an explicit UI banner indicating Demo Authentication.
# In production (APP_ENV=production), ENABLE_DEV_OTP is automatically forced to false.
ENABLE_DEV_OTP=true

# 3. Initial Demo Marketplace Seed
# When true, seeds 4 clearly labeled [Demo Listing] farm crops if the products table is empty.
SEED_DEMO_DATA=true

# 4. SMS Authentication Provider Configuration
# Supported values: none | twilio | fast2sms
SMS_PROVIDER=none

# Option A: Twilio SMS Configuration (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Option B: Fast2SMS Configuration for India +91 numbers (if SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=
